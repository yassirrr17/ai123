# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key -- server-only, never exposed to the browser. Used for the
# public /r/[token] review page and the daily automation cron.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (resend.com/api-keys)
RESEND_API_KEY=your-resend-api-key
# Must be on a domain you've verified in Resend. Leave unset to use the shared
# onboarding@resend.dev test sender (fine for trying the app out, not for real use).
RESEND_FROM_EMAIL="ReviewFlow AI <reviews@yourdomain.co.nz>"

# Public URL of this app once deployed (used to build review links in emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Random secret used to authorize the daily cron endpoint (any long random string)
CRON_SECRET=change-me-to-a-random-string
